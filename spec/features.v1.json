{
  "schema_version": "1.0.0",
  "description": "Starter controlled, expandable feature ontology for evidence-aware, personalized anime recommendations; feature magnitude is not user preference.",
  "scale": {
    "min": 0,
    "max": 1,
    "unknown": null,
    "description": "0 means the observed trait is absent/low (if evidence supports absence); 1 means high, null means unknown. Never map unknown to 0. User preference direction stored separately."
  },
  "confidence": {
    "min": 0,
    "max": 1,
    "description": "source-quality/confidence independent from feature magnitude"
  },
  "source_evidence_types": [
    "official_metadata",
    "synopsis",
    "user_review",
    "public_review",
    "editorial_article",
    "owned_mkv_frames",
    "approved_promo_stills",
    "cover_only",
    "manually_curated"
  ],
