    "missing_reason": "string|null"
  },
  "user_feedback_fields": {
    "aspect": "feature_key",
    "direction": [
      "liked",
      "disliked",
      "neutral",
      "mixed",
      "unknown"
    ],
    "strength": "float 0..1",
    "context_note": "optional text",
    "linked_work_ids": "uuid[]",
    "observed_at": "timestamp"
  },
  "rules": [
    "Never treat high feature intensity as positive user preference without explicit evidence",
    "Always separate relationship canon from subtext",
    "Actual animation motion and consistency require video evidence",
    "Poster aesthetics may be measured but cannot establish motion/animation quality",
    "Do not let genre mismatch serve as hard exclusion",
    "An ambiguous public review is an uncertain source, not a user preference",
    "Allow interactions between features and contexts, and uncertainty masks"
  ]
}
