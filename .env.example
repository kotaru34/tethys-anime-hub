# Do not commit the real .env file. Run: chmod 600 .env
POSTGRES_DB=anime
POSTGRES_USER=anime
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://anime:REPLACE_WITH_RANDOM_PASSWORD@db:5432/anime
APP_USERNAME=admin
APP_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX
# Jellyfin host/IP reachable from the Docker VM, not localhost unless Jellyfin runs there.
JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_PUBLIC_URL=http://192.168.1.50:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
# Host path inside the Docker VM, shared read-only. This must be the actual absolute path.
ANIME_PATH=/Anime
TZ=Europe/Berlin
SHOKO_IMAGE=ghcr.io/shokoanime/server:latest
PUID=1000
PGID=1000
BIND_IP=0.0.0.0
# Set to 1 only when browsing via HTTPS reverse proxy
COOKIE_SECURE=0
SYNC_INTERVAL_SECONDS=1800
ENRICH_INTERVAL_SECONDS=7200
SUBTITLE_INTERVAL_SECONDS=10800
TARGET_AUDIO_LANGUAGE=ukr
# Optional local OpenAI-compatible llama-server. Leave empty until tested.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
